<Window x:Class="Arcadia.Agent.Shell.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight" Focusable="False">
    <Border Background="#E6050A24" CornerRadius="14" Padding="14,8" BorderBrush="#FF1A2A7A" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="Time" Foreground="White" FontSize="26" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Note" Foreground="#FFFFC857" FontSize="13" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
